# Copy to .env to override settings locally (.env is git-ignored).
# Nested settings use a double underscore: VAXLAKE_<SECTION>__<KEY>.
# No secrets are needed in this project: all data sources are public.

# Profile file in conf/ (dev | ci)
VAXLAKE_PROFILE=dev

# Examples
# VAXLAKE_SPARK__DRIVER_MEMORY=2g
# VAXLAKE_SCOPE__UFS=["SP","MG","RJ","ES"]
# VAXLAKE_PATHS__DATA_DIR=data
# VAXLAKE_LOGGING__LEVEL=DEBUG
