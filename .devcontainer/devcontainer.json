// Development environment as code — used by GitHub Codespaces and by VS Code "Dev Containers".
// Spec: https://containers.dev/implementors/json_reference/
{
  "name": "sus-vaccination-lakehouse",
  // Debian-based Python 3.11 image maintained by the Dev Containers project.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",

  "features": {
    // Spark 4.x needs Java 17+. Temurin matches the JDK used in CI (actions/setup-java).
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "jdkDistro": "tem"
    }
  },

  // Smallest Codespaces machine that runs Spark comfortably (2 cores / 8 GB RAM).
  // Choose a 4-core machine manually only for heavy runs — it uses the free quota twice as fast.
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },

  "containerEnv": {
    // The Python that Spark workers use must be the same as the driver's.
    "PYSPARK_PYTHON": "python",
    "PYSPARK_DRIVER_PYTHON": "python",
    // Selects conf/dev.yaml (see src/vaccination_lakehouse/config.py).
    "VAXLAKE_PROFILE": "dev"
  },

  "postCreateCommand": "bash scripts/post_create.sh",

  "forwardPorts": [4040, 8501],
  "portsAttributes": {
    "4040": { "label": "Spark UI", "onAutoForward": "notify" },
    "8501": { "label": "Streamlit dashboard", "onAutoForward": "notify" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-toolsai.jupyter",
        "redhat.vscode-yaml",
        "editorconfig.editorconfig",
        "bierner.markdown-mermaid"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true
        }
      }
    }
  }
}
